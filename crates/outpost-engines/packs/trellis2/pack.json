    {
      "key": "name",
      "label": "Name (optional)",
      "kind": "text",
      "default": "",
      "targets": [],
      "help": "What to call it, e.g. Sheep. The gallery shows it, and saving uses it for the file (Sheep.3mf)."
    },
    {
      "key": "for_printing",
      "label": "Ready for 3D printing",
      "kind": "toggle",
      "default": true,
      "targets": [],
      "help": "Also saves it for slicers like Bambu Studio (.3mf): standing upright, flat on the bed, at the height below. Turn off for games and 3D apps (.glb only)."
    },
    {
      "key": "print_height",
      "label": "Print height (mm)",
      "kind": "integer",
      "default": 100,
      "min": 10,
      "max": 300,
      "step": 5,
      "advanced": true,
      "targets": [],
      "help": "How tall the printed model is. You can still resize it in the slicer."
    },
    {
      "key": "print_colours",
      "label": "Colours for printing",
      "kind": "choice",
      "default": "4 colours",
      "options": [
        "One colour",
        "2 colours",
        "3 colours",
        "4 colours"
      ],
      "targets": [],
      "help": "For a multi-colour printer (an AMS): the model's colours become this many filaments in the .3mf, most used first. One colour prints it plain."
    },
    {
      "key": "print_base",
      "label": "Base for printing",
      "kind": "choice",
      "default": "As made",
      "options": [
        "As made",
        "Flat bottom",
        "Flat back"
      ],
      "advanced": true,
      "targets": [],
      "help": "Flat bottom slices a little off the bottom so it stands steady. Flat back lays it on its back, cut flat (wall pieces, reliefs)."
    },
    {
      "key": "texture",
      "label": "Texture detail",
      "kind": "choice",
      "default": "Standard (2K)",
      "options": [
        "Standard (2K)",
