<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Finding Outposts on the Wi-Fi (mDNS) needs multicast. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Talking to a persona: asked for the first time the microphone is used. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Updating the app from inside it: Android asks once to allow it, and (Android 14+)
       later updates of itself can go in without a prompt. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- "It's ready" notifications for long jobs (asked for on Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Watching for finished jobs while they run (a quiet notification shows it). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <!-- Instant news: a line kept open to the Outpost (shown by a notification, with Stop), and
       awake long enough to say what arrives with the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 11+ only shows apps the speech recognizer if they say they look for it. -->
  <queries>
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>
  <application>
    <service
        android:name="expo.modules.outpostnet.JobWatchService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
    <service
        android:name="expo.modules.outpostnet.NewsService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Keeps a connection to the user's own home server open so doorbell and routine alerts arrive immediately" />
    </service>
    <!-- Looking for a routine's result just after it's due (an alarm Android allows while idle). -->
    <receiver
        android:name="expo.modules.outpostnet.RoutineAlarm"
        android:exported="false" />
  </application>
</manifest>
