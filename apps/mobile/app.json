{
  "expo": {
    "name": "Outpost",
    "slug": "outpost",
    "version": "0.1.13",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121013",
    "newArchEnabled": true,
    "android": {
      "package": "app.outpost.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#280C01"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Outpost uses the camera to scan the pairing code on your PC.",
          "recordAudioAndroid": true,
          "microphonePermission": "Outpost uses the microphone when you talk to a persona."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Outpost lets you pick a picture to edit or animate."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Outpost with your face."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "./plugins/release-signing"
    ]
  }
}
