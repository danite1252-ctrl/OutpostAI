{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost",
  "version": "0.1.5",
  "identifier": "app.outpost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Outpost",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#121013",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7420; img-src 'self' data: blob: http://127.0.0.1:7420; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your private AI outpost",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "OutpostAI",
    "copyright": "MIT licence",
    "homepage": "https://github.com/danite1252-ctrl/OutpostAI",
    "longDescription": "Outpost runs AI on your own PC: chat, pictures, voice and character training, for you and your household, with nothing sent to the cloud.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMzRERkJCNzk0MzE3MTkKUldRWkYwTjV1OTgwWU5JOS9UdlFOMU9DMDMwU2ptRnNSZGt6ekFDcHI3Y0gvN0o2bis5UXorZ0oK",
      "endpoints": [
        "https://github.com/danite1252-ctrl/OutpostAI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
